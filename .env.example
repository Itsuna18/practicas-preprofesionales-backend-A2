DATABASE_URL="postgresql://practicas:practicas@localhost:5432/practicas?schema=public"
JWT_SECRET="cambiame-en-produccion"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
HOUR_LOG_MAX_HOURS=10

# Puerto en el que docker-compose publica Postgres. Si 5432 ya está ocupado en
# tu máquina, cámbialo aquí y en DATABASE_URL.
POSTGRES_PORT=5432

# Zona horaria institucional para normalización de fechas del libro de horas (E6-02)
INSTITUTIONAL_TIMEZONE="America/Guayaquil"

# Asistente con IA (extra: chat). Sin configurar, el resto de la API funciona
# igual y el chat avisa que falta configurarlo. Nunca subas tus claves al repo.
#
# Opción gratis recomendada: Groq. Crea la clave sin tarjeta en
# https://console.groq.com/keys y pégala aquí.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
#
# Opción gratis sin internet: Ollama (instala https://ollama.com, luego
# "ollama pull llama3.2") y descomenta:
# AI_PROVIDER="ollama"
# OLLAMA_MODEL="llama3.2"
#
# Opción de pago: Claude (https://platform.claude.com).
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"
#
# Si configuras más de una, AI_PROVIDER elige (groq, ollama o anthropic).
